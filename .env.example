# ==============================
# OLAH Backend - Environment Variables
# CC26-PSU127
# ==============================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.xxxxx.mongodb.net/olah_db?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Client URL (untuk CORS - URL frontend React)
CLIENT_URL=http://localhost:5173

# ── AI Model Service (Tim AI - FastAPI) ──────────────────────────────────────
# URL FastAPI yang dijalankan Tim AI (inference engine TensorFlow)
# Development: http://localhost:8000
# Production : sesuaikan dengan URL deploy Tim AI
AI_MODEL_URL=http://localhost:8000

# Timeout request ke AI service dalam milliseconds (default 8 detik)
# Jika AI service lambat load model, naikkan nilai ini
AI_TIMEOUT_MS=8000
